{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LittleTool",
  "version": "0.0.1",
  "identifier": "yifeng.littletool",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5RUUyQTg1RjQzNzdGQkQKUldTOWZ6ZjBoU3J1ZWVBTUpJSnhKbDlOd1dFYVllSmtmOWQ0SVVqNXlUNWxsUTAvMU12NzJFRXEK",
      "endpoints": [
        "https://github.com/fensu/littletool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "littletool",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
